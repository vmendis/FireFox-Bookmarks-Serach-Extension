{
    "manifest_version": 2,
    "name": "Bookmark Search",
    "version": "1.0.0",
    "description": "Quickly search and open bookmarks from a Firefox sidebar",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },
    "permissions": [
        "bookmarks",
        "tabs"
    ],
    "sidebar_action": {
        "default_title": "Bookmark Search",
        "default_panel": "sidebar/sidebar.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "96": "icons/icon-96.png"
        },
        "browser_style": true
    }
}